# Copy to `.env` and adjust. Never commit `.env` (it is git-ignored).
# Values here are safe public defaults for the JSONPlaceholder fake API.
# No real credentials are needed: JSONPlaceholder requires no auth.

# Base URL of the API under test.
API_BASE_URL=https://jsonplaceholder.typicode.com

# Per-request timeout in seconds.
REQUEST_TIMEOUT=10

# Optional: only set if you point API_BASE_URL at an API that needs auth.
# Leave empty for JSONPlaceholder.
# API_TOKEN=
